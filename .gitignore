# This working directory may also contain a private engineering archive.
# Publish only the reviewed source and release inputs; do not import the archive.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/llms.txt
!/CONTRIBUTING.md
!/THIRD_PARTY.md
!/NOTICE.md
!/LICENSE
!/LICENSES/
!/AGENTS.md
!/project.ps1
!/project.json
!/pyproject.toml
!/uv.lock
!/.python-version
!/tools/
!/release/
!/docs/
/docs/*
!/docs/assets/
!/docs/CAD-BUILD.md
!/docs/VIEWER.md
# Public maker guides are Markdown; other working files in this area stay local.
!/docs/guides/
/docs/guides/**
!/docs/guides/**/
!/docs/guides/**/*.md

# Historical CAD folders mix source, privately supplied material and generated
# files. Their reviewed inputs are explicitly tracked; edits to them show as
# normal Git changes. For a new input, see CONTRIBUTING.md.
!/cad/
/cad/*
!/cad/solidcraft-m1/
/cad/solidcraft-m1/*
!/cad/solidcraft-m1/calibration/
/cad/solidcraft-m1/calibration/*
!/cad/solidcraft-m1/calibration/calibration-cube-20mm.stl
!/cad/solidcraft-m1/prototype-d26/
/cad/solidcraft-m1/prototype-d26/*
