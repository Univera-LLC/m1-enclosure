!/cad/solidcraft-m1/prototype-d26/base-fit.json
!/cad/solidcraft-m1/prototype-d26/board-study/
/cad/solidcraft-m1/prototype-d26/board-study/*
!/cad/solidcraft-m1/prototype-d26/board-study/port-contract.json
# D2.7 source and the reviewed release exports. Build caches and photos stay local.
!/cad/solidcraft-m1/prototype-d27/
